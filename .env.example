# Google Gemini
GEMINI_API_KEY=your_key_here
# Optional: pin the model. Defaults to gemini-3.8-flash with automatic
# failover across eight flash models on quota/capacity errors.
GEMINI_MODEL=gemini-3.8-flash

# --- Vertex AI on Google Cloud (recommended: no per-model free quota) ---
# With these set, GEMINI_API_KEY is not used at all.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Vertex serves a different catalogue than AI Studio: on our project every 3.x
# model returns 404, while the 2.5 family (including 2.5-pro) works. The agent
# switches model pool automatically - see VERTEX_MODELS in gemini_client.py and
# run scripts/check_vertex.py to confirm what your own project can reach.

# ClickHouse Cloud (GCP)
CLICKHOUSE_HOST=xxxxxxxx.region.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DATABASE=cinecompute
CLICKHOUSE_SECURE=True
# Set to False only if your ClickHouse uses a self-signed certificate
CLICKHOUSE_VERIFY=True

# For a local ClickHouse instead, use:
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_SECURE=False
