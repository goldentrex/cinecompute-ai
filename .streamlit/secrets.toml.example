# Streamlit Community Cloud: paste this into the app's "Secrets" panel.
# Streamlit exposes every secret as an environment variable too, which is how
# app/config.py (pydantic-settings) picks them up.

GEMINI_API_KEY = "your_key_here"
GEMINI_MODEL = "gemini-3.8-flash"

# --- Vertex AI instead of the AI Studio key (no free-tier quota ceiling) ---
# GOOGLE_GENAI_USE_VERTEXAI = "True"
# GOOGLE_CLOUD_PROJECT = "your-project-id"
# GOOGLE_CLOUD_LOCATION = "us-central1"
# Paste the whole service account key file here; the app writes it to a private
# temp file at startup because Streamlit Cloud has no filesystem to prepare.
# GOOGLE_CREDENTIALS_JSON = """{ "type": "service_account", ... }"""

CLICKHOUSE_HOST = "xxxxxxxx.region.gcp.clickhouse.cloud"
CLICKHOUSE_PORT = "8443"
CLICKHOUSE_USER = "default"
CLICKHOUSE_PASSWORD = "your_password_here"
CLICKHOUSE_DATABASE = "cinecompute"
CLICKHOUSE_SECURE = "True"

# Public hardening: replay recorded presets for free, cap live questions per visitor.
AGENT_CACHE_MODE = "replay"
PUBLIC_DEMO = "1"
LIVE_QUESTION_BUDGET = "3"
